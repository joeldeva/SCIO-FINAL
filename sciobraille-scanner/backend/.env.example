# Configure process environment; no automatic dotenv loading.
TRANSLATION_PROVIDER=disabled
TRANSLATION_API_KEY=
LIBRETRANSLATE_URL=http://127.0.0.1:5000
BRAILLE_CONF=0.25
BRAILLE_AUTO_ORIENTATION=true
BRAILLE_MAX_UPLOAD_BYTES=20971520
BRAILLE_MAX_IMAGE_PIXELS=32000000
# Never enable the unauthenticated prototype LMS API on a public service.
# BRAILLE_ENABLE_LMS_API=development
